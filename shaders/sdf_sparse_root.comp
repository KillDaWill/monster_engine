layout(local_size_x=64) in;
vec3 edgeRoot(vec3 a,vec3 b,float da,float db){
    float t=clamp(da/(da-db),0.0,1.0);vec3 p=mix(a,b,t);
    for(int i=0;i<refinementSteps;++i){float d=sceneDistance(p);if((d<0.0)==(da<0.0)){a=p;da=d;}else{b=p;db=d;}
        float denominator=da-db;t=abs(denominator)>1e-12?clamp(da/denominator,0.0,1.0):.5;p=mix(a,b,t);}return p;}
void main(){uint i=invocation();if(i>=edgeCapacity||(edges[i].key==0u||edges[i].key==0xffffffffu)||edges[i].version!=generation)return;
    uint key=edges[i].key-1u,axis=key%3u,corner=key/3u;uvec3 s=gridCells+uvec3(1);
    uvec3 a=uvec3(corner%s.x,(corner/s.x)%s.y,corner/(s.x*s.y)),b=a;b[axis]+=1u;
    atomicAdd(unused0,1u);MonsterSDFUseCompleteScene();vec3 pa=gridPoint(ivec3(a)),pb=gridPoint(ivec3(b));
    vec3 p=edgeRoot(pa,pb,edges[i].d0,edges[i].d1);float t=clamp((p[axis]-pa[axis])/gridStep,0.0,1.0);
    float magnitude=min(length(edges[i].g0.xyz),length(edges[i].g1.xyz));
    float curvature=max(edges[i].g0.w,edges[i].g1.w);
    bool refine=cachedNormals==0||magnitude<.35||curvature>.035*magnitude||
        length(edges[i].g0.xyz-edges[i].g1.xyz)>.08*magnitude;
    vec3 n=refine?MonsterSDFGradient(p,.00065):normalize(mix(edges[i].g0.xyz,edges[i].g1.xyz,t));
    if(refine)atomicAdd(exactNormalCount,1u);
    uint ia=cornerIndex(a),ib=cornerIndex(b);if(all(equal(p,pa)))ib=ia;else if(all(equal(p,pb)))ia=ib;
    vertices[i]=SurfaceVertex(vec4(p,uintBitsToFloat(ia)),vec4(n,uintBitsToFloat(ib)));
}
