uniform int statisticsPass;
uniform uint metadataCount;
layout(local_size_x=128) in;
void main(){uint i=invocation();
    if(statisticsPass==0){
        if(i<metadataCount&&bricks[i].nearSurface==0u&&bricks[i].farAge!=0u&&generation-bricks[i].farAge>3u)releaseSamples(i);
        if(i<metadataCount&&bricks[i].sampleSlot!=0xffffffffu&&bricks[i].pad1!=generation)atomicAdd(unused2,sampleCount());
        if(i<pageCapacity)atomicAdd(unused1,draws[i].count);
    } else if(statisticsPass==2 && i<min(retiredCount,edgeCapacity)) {
        uint edge=RetiredEdge(i);
        if(edges[edge].statistics.y==0u) {edges[edge].key=0xffffffffu;edges[edge].version=0u;}
    } else if(statisticsPass==3 && i<min(retiredCount,edgeCapacity)) {
        uint edge=RetiredEdge(i);
        // Acortar únicamente el extremo vacío de la cadena. El recorrido
        // acotado consume candidatos, nunca barre toda la tabla hash.
        for(uint step=0u;step<64u;++step) {
            uint next=(edge+1u)&(edgeCapacity-1u);
            if(atomicAdd(edges[next].key,0u)!=0u ||
               atomicCompSwap(edges[edge].key,0xffffffffu,0u)!=0xffffffffu)break;
            edge=(edge+edgeCapacity-1u)&(edgeCapacity-1u);
        }
    }
}
