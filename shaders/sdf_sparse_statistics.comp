uniform int statisticsPass;
uniform uint metadataCount;
layout(local_size_x=128) in;
void main(){uint i=invocation();
    if(statisticsPass==0){
        if(i<metadataCount&&bricks[i].nearSurface==0u&&bricks[i].farAge!=0u&&generation-bricks[i].farAge>3u)releaseSamples(i);
        if(i<metadataCount&&bricks[i].sampleSlot!=0xffffffffu&&bricks[i].pad1!=generation)atomicAdd(unused2,sampleCount());
        if(i<pageCapacity)atomicAdd(unused1,draws[i].count);
    }else if(statisticsPass==1&&i<pageCapacity*PAGE_VERTICES){uint page=i/PAGE_VERTICES,offset=i%PAGE_VERTICES;
        if(offset<draws[page].count){uint index=indices[i];if(atomicExchange(edges[index].statistics.x,generation)!=generation)atomicAdd(unused3,1u);}}
    else if(statisticsPass==2&&i<edgeCapacity&&edges[i].key!=0u&&edges[i].key!=0xffffffffu&&edges[i].statistics.x!=generation){
        // Tombstone: conserva la cadena de colisiones sin retener una arista obsoleta.
        edges[i].key=0xffffffffu;edges[i].version=0u;
    }else if(statisticsPass==3&&i<edgeCapacity&&edges[i].key==0xffffffffu){
        // Sólo se acorta una cadena si no queda ninguna clave viva detrás del hueco.
        uint next=(i+1u)&(edgeCapacity-1u);
        for(uint probe=0u;probe<edgeCapacity;++probe){
            uint key=atomicAdd(edges[next].key,0u);
            if(key==0u){atomicCompSwap(edges[i].key,0xffffffffu,0u);break;}
            if(key!=0xffffffffu)break;
            next=(next+1u)&(edgeCapacity-1u);
        }
    }
}
