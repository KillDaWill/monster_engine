#version 430
layout(local_size_x=64) in;
uniform vec4 surfaceRecipe[139];
uniform uint pigmentSeed;
uniform int pointCount;
layout(std430,binding=0) readonly buffer Points {vec4 points[];};
layout(std430,binding=1) writeonly buffer Results {vec4 results[];};
// La validación no usa filtrado por huella; las derivadas sólo existen en fragment.
#define dFdx(x) ((x)*0.0)
#define dFdy(x) ((x)*0.0)
#include "surface/hash.glsl"
#include "surface/pigment.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=uint(pointCount))return;
    PigmentSetRegions(points[2u*i+1u]);
    results[i]=vec4(PigmentDomainDebug(points[2u*i].xyz),EvaluatePigmentMaterial(points[2u*i].xyz,.65));
}
