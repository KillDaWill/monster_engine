layout(local_size_x=128) in;
void main() {
    uint local=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*gl_WorkGroupSize.x+gl_LocalInvocationID.x;
    if(local>=slabCellCount)return;uint id=slabCellBase+local;
    uvec3 p=cellCoord(id);uint mask=0u;
    for(int c=0;c<8;++c)if(samples[sampleIndex(p+cornerOffset(c))]<0.0)mask|=1u<<c;
    if(mask!=0u&&mask!=255u)activeCases[atomicAdd(activeCount,1u)]=uvec2(id,mask);
}
