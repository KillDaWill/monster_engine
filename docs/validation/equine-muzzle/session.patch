+"layout(std430,binding=4) writeonly buffer Output {Vertex posed[];};\n",
+"uniform uint vertexCount;\n",
+"void main() {\n",
+"    uint v=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*gl_WorkGroupSize.x+gl_LocalInvocationID.x;\n",
+"    if(v>=vertexCount)return;\n",
+"    vec3 bp=vec3(base[v].px,base[v].py,base[v].pz),bn=vec3(base[v].nx,base[v].ny,base[v].nz);\n",
